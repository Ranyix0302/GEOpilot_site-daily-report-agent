# Copy this file to .env and enter secrets locally. Never commit .env.
# Competition LLM gateway. Uncomment these three lines for the AWS deployment.
# LLM_GATEWAY_URL=https://api.softwaresystems.app
# LLM_GATEWAY_API_KEY=replace-with-your-team-api-key
# LLM_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Optional legacy DeepSeek configuration for local development. It is used only
# when LLM_GATEWAY_URL is not set.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_MODEL=deepseek-flash
# Optional override; the defaults are normally appropriate.
DEEPSEEK_BASE_URL=https://api.deepseek.com
VISION_CONFIDENCE_THRESHOLD=0.75

# Feishu/Lark Open Platform credentials. Choose the correct domain.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_DOMAIN=https://open.feishu.cn
# Bitable App Token + Table ID (these are different from App ID/Secret).
LARK_BASE_APP_TOKEN=
LARK_TABLE_ID=

# Optional; defaults to local timezone report date handling.
APP_SECRET_KEY=change-this-local-secret
MAX_UPLOAD_MB=100
