# Copy this file to .env and enter secrets locally. Never commit .env.
# DeepSeek vision credential. Keep the real value in .env and never share that file.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_MODEL=deepseek-flash
# Optional override; the defaults are normally appropriate.
DEEPSEEK_BASE_URL=https://api.deepseek.com
VISION_CONFIDENCE_THRESHOLD=0.75

# Feishu/Lark Open Platform credentials. Choose the correct domain.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_DOMAIN=https://open.feishu.cn
# Bitable App Token + Table ID (these are different from App ID/Secret).
LARK_BASE_APP_TOKEN=
LARK_TABLE_ID=

# Optional; defaults to local timezone report date handling.
APP_SECRET_KEY=change-this-local-secret
MAX_UPLOAD_MB=100
